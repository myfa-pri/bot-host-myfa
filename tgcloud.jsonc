{
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json",
  "static": {
    "source": "public",
    "spa": true,
    "headers": [
      {
        "path": "/*",
        "set": {
          "Referrer-Policy": "no-referrer",
          "X-Content-Type-Options": "nosniff"
        }
      }
    ]
  }
}
